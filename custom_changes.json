{
  "version": "1.1",
  "purpose": "Tracks local customization drift against upstream. When a sync conflict lands on one of these files, added_line_ranges_vs_upstream_main tells which hunks are 'mine' and which are 'theirs'.",
  "upstream_repo": "https://github.com/Wei-Shaw/sub2api",
  "upstream_remote_name": "origin",
  "fork_remote_name": "myfork",
  "branch_model": {
    "main": "Pure mirror of upstream/main. Never carry local commits here - GitHub's Sync fork button stays available only while this holds.",
    "custom": "upstream/main + all local work. This is the build and deploy branch."
  },
  "upstream_base": "3a6fd1c9d",
  "last_sync": "2026-10-10",
  "sync_command": "sync-upstream.bat (local-only, untracked)",
  "build_command": "rebuild-sub2api.bat (tracked; frontend + go build -tags embed + swap + restart)",
  "platform_patches": [
    {
      "file": "backend/internal/pkg/timezone/timezone.go",
      "why": "Windows-only necessity, not a preference. Upstream's timezone package calls time.LoadLocation at startup with the default Asia/Shanghai and ships no tzdata; Windows has no system zoneinfo, so startup aborted and no business routes were registered (UI loaded, every API 404). A blank import of time/tzdata embeds the IANA database. Worth offering upstream - the app cannot start on Windows without it.",
      "recheck_after_sync": "If upstream adds time/tzdata itself, drop this patch."
    }
  ],
  "local_only_files": [
    "sync-upstream.bat - one-click upstream sync. MUST stay untracked: it runs 'git checkout main' internally, so if it were tracked the branch switch would delete the running script."
  ],
  "tracked_local_files": [
    "DEV_GUIDE.local.md - this machine's Win11 runbook. Renamed from DEV_GUIDE.md so it never collides with upstream's own DEV_GUIDE.md.",
    "start-sub2api.bat / stop-sub2api.bat / rebuild-sub2api.bat - Windows launcher and rebuild scripts. Upstream has no such filenames, so they can never conflict; being tracked restores core.autocrlf's CRLF conversion for .bat (there is no .bat rule in .gitattributes)."
  ],
